{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webhook-intercept",
	"account_id": "020b98da900a40e5430002971996388b",
	"main": "src/index.ts",
	// Keep current: new Workers should use today's date.
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	// Non-secret config. INSPECT_TOKEN is a secret (`.dev.vars` locally, `wrangler secret put` in prod).
	"vars": {
		"BODY_MAX_BYTES": "10485760"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "webhook-intercept",
			"database_id": "8d29c1fe-f866-41cd-b56c-b236a83f1bfa",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "webhook-capture-bodies"
		}
	],
	"triggers": {
		"crons": ["0 3 * * *"]
	}
}
